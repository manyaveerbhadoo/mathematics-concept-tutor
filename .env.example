# Copy this file to `.env` and fill it in.
# NEVER commit `.env` -- it is already in .gitignore. If a token ever leaks,
# regenerate it immediately in the Discord developer portal.

# From https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste_your_bot_token_here

# Your test server's ID (right-click the server -> Copy Server ID, with
# Developer Mode on). Makes slash commands appear instantly instead of
# taking up to an hour to propagate.
DISCORD_GUILD_ID=

# Comma-separated Discord user IDs allowed to run /report.
INSTRUCTOR_IDS=

# Any long random string. It salts the hash used for anonymous analytics.
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing it later resets your analytics history.
MATHBOT_SALT=

# Where the SQLite log file lives.
MATHBOT_DB=mathbot.db
